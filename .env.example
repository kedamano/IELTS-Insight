# IELTS Insight — 环境变量示例
# 复制本文件为 `.env` 放到 backend/ 目录（后端 pydantic-settings 从 backend/.env 读取）。
# `.env` 已被 .gitignore 忽略，切勿提交。
#
# ⚠️ 凭据纪律（CONSTITUTION §3）：
#   - API key / base_url / model 只从 .env 读取，可被「设置」页覆盖后存进本地 settings 表；
#   - 这些值【绝不写日志】、【绝不出现在任何接口返回值或错误信息里】；
#   - key 永远留在 .env，不上传、不提交、不回显明文（AC-C2：GET 只返回 ai_key_present）。

# ---- AI（OpenAI 兼容端点；留空则所有 AI 评分走本地近似并标注「离线近似」）----
OPENAI_API_KEY=
# 兼容端点 base_url，例如 DeepSeek / 通义千问 / 自建网关。留空用官方 https://api.openai.com/v1
OPENAI_BASE_URL=
# 模型名，例如 gpt-4o-mini / deepseek-chat / qwen-plus
OPENAI_MODEL=gpt-4o-mini

# ---- 本地数据路径（一般不用改；不设置时后端默认用 %LOCALAPPDATA%/IELTSInsight）----
# 数据库文件绝对路径。默认 = %LOCALAPPDATA%/IELTSInsight/app.db（测试用 IELTS_DB_PATH 覆盖到 tmp）
IELTS_DB_PATH=
# edge-tts 合成音频缓存目录。默认 = %LOCALAPPDATA%/IELTSInsight/cache/tts
IELTS_TTS_CACHE_DIR=
# 是否允许联网能力（TTS 合成 / AI 调用）。false 时强制走离线降级路径
IELTS_ONLINE=true

# ---- 后端监听端口（前端 api.ts 与此一致；改动需同步 tauri.conf.json 的 CSP）----
API_PORT=8765
