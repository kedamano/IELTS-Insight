{
  "productName": "AI Language Dialogue",
  "version": "0.1.0",
  "identifier": "com.ailanguage.dialogue",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "externalBin": ["binaries/backend"]
  },
  "app": {
